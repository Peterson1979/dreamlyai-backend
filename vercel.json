{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.dreamlyai.life"
        }
      ],
      "destination": "https://dreamlyai.life/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/api/privacy-policy"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/api/privacy-policy"
    },
    {
      "source": "/terms-of-use",
      "destination": "/api/terms-of-use"
    },
    {
      "source": "/terms-of-use/",
      "destination": "/api/terms-of-use"
    },
    {
      "source": "/ai-disclaimer",
      "destination": "/api/ai-disclaimer"
    },
    {
      "source": "/ai-disclaimer/",
      "destination": "/api/ai-disclaimer"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/dreams",
      "destination": "/api/dreams/index"
    },
    {
      "source": "/dreams/",
      "destination": "/api/dreams/index"
    },
    {
      "source": "/dreams/:topic",
      "destination": "/api/dreams/[topic]?topic=:topic"
    },
    {
      "source": "/dreams/:topic/",
      "destination": "/api/dreams/[topic]?topic=:topic"
    }
  ],
  "crons": [
    {
      "path": "/api/social-run",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/video-run",
      "schedule": "0 16 * * *"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "social/fonts/**"
    }
  }
}
