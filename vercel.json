{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/api/privacy-policy"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/api/privacy-policy"
    }
  ],
  "crons": [
    {
      "path": "/api/social-run",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "social/fonts/**"
    }
  }
}
